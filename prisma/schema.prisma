generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  subtitle  String?
  body      String
  imageUrl  String?
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  content     String?
  imageUrl    String?
  purchaseUrl String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Int
  salePrice   Int?
  soldCount   Int         @default(0)
  rating      Float       @default(5)
  tags        String
  images      String
  specs       String
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  coverUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  customer    String
  email       String
  phone       String
  address     String
  note        String?
  status      String      @default("PENDING")
  subtotal    Int
  shippingFee Int         @default(60)
  total       Int
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Int
  quantity  Int
  spec      String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model NezhaAccount {
  id                 String             @id @default(cuid())
  username           String             @unique
  salt               String
  passwordHash       String
  nickname           String?
  suspendedAt        DateTime?
  chatMutedUntil     DateTime?
  selectedCharacter  String             @default("nezha")
  jigongUnlockedAt   DateTime?
  jigongGrantedAt    DateTime?
  unlockRunId        String?
  unlockRunStartedAt DateTime?
  sessions           NezhaSession[]
  score              NezhaScore?
  chatMessages       NezhaChatMessage[]
}

model NezhaChatMessage {
  id        Int          @id @default(autoincrement())
  accountId String
  account   NezhaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  body      String       @db.VarChar(140)
  createdAt DateTime     @default(now())
  hiddenAt  DateTime?

  @@index([createdAt])
  @@index([accountId])
}

model NezhaSession {
  token     String       @id
  accountId String
  account   NezhaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
  @@index([accountId])
}

model NezhaScore {
  accountId       String       @id
  account         NezhaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cleared         Int
  progress        Int
  kills           Int
  recordedAt      DateTime     @default(now())
  message         String?      @db.VarChar(80)
  messageCredits  Int?
  messageHiddenAt DateTime?

  @@index([cleared(sort: Desc), progress(sort: Desc), kills(sort: Desc), recordedAt, accountId])
}

model NezhaRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
