DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set both variables to enable /games/nezha/gm. Use a unique random secret.
# NEZHA_GM_USERNAME=""
# NEZHA_GM_SECRET=""
# Major Update 001: on by default in local development and Vercel Production.
# Use 0 to disable one feature, or 1 to enable in an isolated Vercel Preview.
# NEZHA_PROFILE="1"
# NEZHA_FRIENDS="1"
# NEZHA_WHISPERS="1"
# NEZHA_PARTIES="1"
# Enable co-op only when a dedicated battle host can serve /room over WSS.
# NEZHA_COOP="0"
# NEZHA_BATTLE_URL="wss://BATTLE_HOST/room"
# NEZHA_BATTLE_SECRET=""
